# Copy this file to .env and fill in the values. .env is not committed (see .gitignore).

# --- Needed ---------------------------------------------------------------

# OCR server: POST a PDF or image, get its text back (app/ocr_api.py; --ocr api)
OCR_API_URL=http://<ocr-server>:<port>/ocr

# Qwen3 14B server for the observations (app/observation.py; --model qwen14b, the default)
QWEN14B_URL=http://<llm-server>:<port>/vllm/generate_greedy

# --- Only for the other engines / models -----------------------------------

# Gemini, for --ocr gemini or --model gemini
GEMINI_API_KEY=

# IndicOCR server, for --ocr indicapi (no trailing slash: with one, it redirects to 127.0.0.1)
INDIC_OCR_API_URL=http://<indic-ocr-server>:<port>/indicocr/ocr_markdown

# Gemma 4 E4B server, for --model gemma-e4b
GEMMA_E4B_URL=http://<llm-server>:<port>/gemma/generate

# --- Optional (these are the defaults) -------------------------------------

# Ollama, for --model gemma and --model qwen3
# OLLAMA_URL=http://localhost:11434
# QWEN3_OLLAMA_URL=http://localhost:11434
# QWEN3_MODEL=qwen3:14b

# IndicOCR: pages per request (0 = whole file) and requests sent at the same time
# INDIC_OCR_CHUNK_PAGES=2
# INDIC_OCR_PARALLEL=1

# Gemini price per million tokens, for the cost line at the end of a run
# GEMINI_INPUT_PRICE_PER_M=1.50
# GEMINI_OUTPUT_PRICE_PER_M=7.50

# Tesseract languages, for the pages Gemini OCR falls back to Tesseract on
# TESSERACT_LANG=eng+kan
